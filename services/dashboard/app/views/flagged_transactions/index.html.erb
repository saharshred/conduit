<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-semibold tracking-tight">Flagged transactions</h1>
  <div class="flex items-center gap-2 text-sm">
    <% if @status_filter == "pending" %>
      <span class="flex items-center gap-1.5 text-xs text-emerald-400" title="Live via Postgres LISTEN/NOTIFY + Turbo Streams — updates the instant the scorer flags something, no polling">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> live
      </span>
    <% end %>
    <% FlaggedTransaction::STATUSES.each do |status| %>
      <%= link_to status.capitalize, flagged_transactions_path(status: status),
            class: "px-3 py-1 rounded border #{status == @status_filter ? 'border-amber-500 text-amber-400' : 'border-slate-700 text-slate-400 hover:border-slate-500'}" %>
      <span class="text-slate-600">(<%= @counts[status] || 0 %>)</span>
    <% end %>
  </div>
</div>

<%# Only the pending view gets pushed live updates — that's the one that
    actually needs them; approved/denied are a reviewer's own history. %>
<% if @status_filter == "pending" %>
  <%= turbo_stream_from "flagged_transactions_pending" %>
<% end %>

<div id="flagged-live">
  <%= render "live_content" %>
</div>
